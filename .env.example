# ── AI Mood Journal — Environment Variables ───────────────────────────────────
# Copy this file to .env and add your free Gemini API key.
# Without it the app runs in Demo Mode (rule-based fallback, no real AI).
#
# Get your FREE key in 2 minutes:
#   1. Go to https://aistudio.google.com/app/apikey
#   2. Click "Create API Key"
#   3. Copy and paste it below — no credit card needed!

GEMINI_API_KEY=your_gemini_api_key_here
